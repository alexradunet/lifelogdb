# Reference copy. Compare it with the installed unit before you replace it (deploy/README.md).
# Started by OnFailure= of lifelog-snapshot.service. It only writes one line to the journal, at priority "error"
# (the "<3>" prefix). Read it with: journalctl -p err -t lifelog-snapshot-failed
[Unit]
Description=Lifelog nightly snapshot failed

[Service]
Type=oneshot
SyslogIdentifier=lifelog-snapshot-failed
ExecStart=/bin/echo "<3>the nightly snapshot of life.db failed; read: journalctl -u lifelog-snapshot.service"
