# Reference copy. Compare it with the installed unit before you replace it (deploy/README.md).
[Unit]
Description=Lifelog nightly snapshot of life.db
# A failure starts the unit below, which writes it to the journal.
OnFailure=lifelog-snapshot-failed.service

[Service]
Type=oneshot
# Replace OWNER and the paths. The user must be the user of lifelog.service.
User=OWNER
Environment=LIFELOG_BIN=/home/OWNER/.local/bin/lifelog
Environment=LIFELOG_DB=/home/OWNER/lifelog/life.db
Environment=LIFELOG_SNAPSHOTS=/home/OWNER/snapshots
ExecStart=/usr/local/bin/lifelog-snapshot
# A stuck snapshot ends as a failure, and so starts OnFailure.
TimeoutStartSec=30min
