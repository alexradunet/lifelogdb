# Reference copy. Compare it with the installed unit before you replace it (deploy/README.md).
[Unit]
Description=Lifelog server (life.db)
After=network.target

[Service]
Type=simple
# Replace OWNER and the paths.
User=OWNER
ExecStart=/home/OWNER/.local/bin/lifelog --db /home/OWNER/lifelog/life.db serve --snapshots /home/OWNER/snapshots
# add --with whatsapp to run the WhatsApp agent beside the server (extensions/whatsapp)
# with ProtectHome=read-only, the agent's state folder must be writable: ReadWritePaths=/home/OWNER/.config/lifelog-whatsapp
# the same holds for the state folder of any connected app: ReadWritePaths=/home/OWNER/.config/lifelog-NAME
Restart=on-failure
# systemd stops the server with SIGTERM. lifelog then drains the requests that it admitted (up to 10 seconds) and
# closes life.db. TimeoutStopSec is longer than the drain, so systemd sends SIGKILL only to a server that is stuck.
KillSignal=SIGTERM
# mixed: SIGTERM reaches lifelog alone, which interrupts its --with children first and then drains; the group is killed only on the timeout
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
