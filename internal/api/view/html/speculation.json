{
  "prerender": [
    {
      "where": {
        "and": [
          { "href_matches": "/*" },
          { "not": { "href_matches": "/*\\?*=*" } },
          { "not": { "href_matches": "/assets/*" } },
          { "not": { "selector_matches": "[target],[download]" } },
          { "not": { "href_matches": "/days/today" } },
          { "not": { "href_matches": "/days/go" } },
          { "not": { "href_matches": "/weeks/today" } },
          { "not": { "href_matches": "/pages/random" } },
          { "not": { "href_matches": "/pages" } },
          { "not": { "href_matches": "/pages/*/preview" } },
          { "not": { "href_matches": "/previews" } },
          { "not": { "href_matches": "/integrity" } },
          { "not": { "href_matches": "/snapshots/*" } },
          { "not": { "href_matches": "/manifest.webmanifest" } }
        ]
      },
      "eagerness": "moderate"
    }
  ]
}
